# Public DSN used by the mobile SDK. DSNs are not secrets.
EXPO_PUBLIC_SENTRY_DSN=https://<public-key>@<org>.ingest.sentry.io/<project-id>
EXPO_PUBLIC_SENTRY_ENVIRONMENT=production
EXPO_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.05
# Set only for local crash-testing; keep unset in normal development.
# EXPO_PUBLIC_SENTRY_DEV=true

# Build-time source-map/native-symbol upload configuration.
SENTRY_ORG=your-sentry-org
SENTRY_PROJECT=brcommunity-android-helper
SENTRY_URL=https://sentry.io/
# SENTRY_AUTH_TOKEN must be provided by CI, never committed.
