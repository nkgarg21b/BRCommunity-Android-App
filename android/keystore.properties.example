# Copy to android/keystore.properties for a local release build.
# NEVER commit android/keystore.properties or your .jks/.keystore file.
# The storeFile path may be absolute or relative to the android/ directory.
storeFile=/secure/path/brcommunity-upload.jks
storePassword=REPLACE_WITH_SECRET
keyAlias=brcommunity-upload
keyPassword=REPLACE_WITH_SECRET
